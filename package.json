{
  "name": "pior-labs-tasks",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.8.1",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @tasks/api --filter @tasks/web dev",
    "dev:api": "pnpm --filter @tasks/api dev",
    "dev:web": "pnpm --filter @tasks/web dev",
    "build": "pnpm --recursive build",
    "typecheck": "pnpm --recursive typecheck",
    "db:generate": "pnpm --filter @tasks/api db:generate",
    "db:migrate": "pnpm --filter @tasks/api db:migrate",
    "test": "pnpm --filter @tasks/api test && pnpm --filter @tasks/web test",
    "test:e2e": "pnpm --filter @tasks/e2e test:e2e",
    "verify": "pnpm typecheck && pnpm test && pnpm build"
  },
  "pnpm": {
    "overrides": {
      "better-auth>vitest": "-"
    }
  }
}
